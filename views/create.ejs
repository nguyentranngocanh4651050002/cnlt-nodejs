<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thêm bài viết</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="container">
    <div class="form-box">
    <h1>➕ Thêm bài viết mới</h1>
    <form action="/create" method="POST">
        <input type="text" name="title" placeholder="Tên xe" required>
        <textarea name="content" placeholder="Mô tả xe" required></textarea>
        <input type="text" name="image" placeholder="Link ảnh xe" required>
        <button type="submit">Thêm bài</button>
    </form>
</div>
</div>
</body>
</html>